# CQ-M02 Configuration Example
# Copy this file to .env and adjust variables as required.

# Application Environment
APP_ENV=development
DEBUG=False

# Optional Threat Intelligence Provider API Keys
# Leave empty for offline / local-heuristic-only mode.
VIRUSTOTAL_API_KEY=
ALIENVAULT_OTX_API_KEY=

# Threat Intelligence Cache TTL in seconds (default: 86400 = 24 hours)
TI_CACHE_TTL_SECONDS=86400

# TI Request Timeout in seconds
TI_REQUEST_TIMEOUT=5

# Database path
SQLITE_DB_PATH=data/domain_detector.db

# Risk Scoring Thresholds (0 to 100)
# Below LOW_THRESHOLD => Low Risk
# Between LOW_THRESHOLD and HIGH_THRESHOLD => Needs Review
# Above HIGH_THRESHOLD => High Risk
RISK_THRESHOLD_LOW=35
RISK_THRESHOLD_HIGH=70
